<Window x:Class="AtletikaV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AtletikaV2"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FA" Height="820" Width="1440">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#19324D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D" />
            <TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása." FontSize="14" Foreground="#52657A" />
        </StackPanel>

        <Border Grid.Column="0" Grid.Row="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Új versenyző" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Label Content="Versenyző neve:" Padding="0,5,0,2" />
                    <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Margin="0,0,0,10" Padding="5,0" />

                    <Label Content="Versenyszám:" Padding="0,5,0,2" />
                    <ComboBox x:Name="cmbVersenyszam" Height="32" Margin="0,0,0,10" IsEditable="False" SelectedIndex="-1">
                        <ComboBoxItem Content="100 m" />
                        <ComboBoxItem Content="200 m" />
                        <ComboBoxItem Content="400 m" />
                        <ComboBoxItem Content="800 m" />
                        <ComboBoxItem Content="1500 m" />
                        <ComboBoxItem Content="Távolugrás" />
                        <ComboBoxItem Content="Magasugrás" />
                        <ComboBoxItem Content="Súlylökés" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <Label Content="Nem:" Padding="0,0,10,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="rbFerfi" GroupName="Nem" Margin="10,0,0,0" Content="Férfi" VerticalContentAlignment="Center" IsChecked="False" />
                        <RadioButton x:Name="rbNo" GroupName="Nem" Margin="25,0,0,0" Content="Nő" VerticalContentAlignment="Center" IsChecked="False" />
                    </StackPanel>

                    <DockPanel LastChildFill="False" Margin="0,5,0,2">
                        <Label Content="Életkor:" DockPanel.Dock="Left" Padding="0" />
                        <TextBlock x:Name="txtEletkor" Text="{Binding ElementName=sldEletkor, Path=Value, StringFormat={}{0} év}" DockPanel.Dock="Right" TextAlignment="Right" FontWeight="Bold" />
                    </DockPanel>

                    <Slider x:Name="sldEletkor" Margin="0,5,0,2" Minimum="18" Maximum="90" Value="18" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"  />

                    <DockPanel LastChildFill="False" Margin="0,0,0,15">
                        <TextBlock Text="18" FontSize="11" Foreground="Gray" DockPanel.Dock="Left" />
                        <TextBlock Text="90" FontSize="11" Foreground="Gray" DockPanel.Dock="Right" />
                    </DockPanel>

                    <Label Content="Korábbi eredmények" FontWeight="Bold" Padding="0,5,0,5" />
                    <CheckBox x:Name="chkOlimpiai" Content="Olimpiai csúcs" IsChecked="False" Margin="0,2,0,5" />
                    <CheckBox x:Name="chkVR" Content="Világcsúcs" IsChecked="False" Margin="0,2,0,5" />
                    <CheckBox x:Name="chkER" Content="Európa-csúcs" IsChecked="False" Margin="0,2,0,15" />

                    <Label Content="Igényelt rajtszám:" Padding="0,5,0,2" />
                    <TextBox x:Name="txtRajtszam" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Margin="0,0,0,2" Padding="5,0" />

                    <Label Content="Üres mező: automatikus kiosztás." FontSize="11" Foreground="Gray" Padding="0,2,0,15" />

                    <Button x:Name="btnRegisztral" Content="REGISZTRÁL" Height="36" Background="#DDEBFA" FontWeight="Bold" Click="Regisztral_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                    <Label Content="Eredményszűrő" FontWeight="SemiBold" VerticalAlignment="Center" Padding="0,0,10,0" DockPanel.Dock="Left" />
                    <ComboBox x:Name="cmbRekordSzuro" Width="220" Height="32" IsEditable="False" SelectedIndex="0" SelectionChanged="Szuro_Valtozott" VerticalContentAlignment="Center" DockPanel.Dock="Left">
                        <ComboBoxItem Content="Összes" />
                        <ComboBoxItem Content="OR - olimpiai csúcs" />
                        <ComboBoxItem Content="VR - világcsúcs" />
                        <ComboBoxItem Content="ER - Európa-csúcs" />
                    </ComboBox>
                </DockPanel>

                <DataGrid x:Name="dgVersenyzok" Grid.Row="1"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column" 
                          SelectionUnit="FullRow" 
                          SelectionMode="Single"
                          RowHeight="32"
                          AlternatingRowBackground="#F4F7FB"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#D4DDE7"
                          ColumnHeaderStyle="{StaticResource HeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rajtszám" Binding="{Binding Rajtszam, Mode=OneWay}" Width="88" />
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Versenyszám" Binding="{Binding Versenyszam, Mode=OneWay}" Width="160" />
                        <DataGridTextColumn Header="Nem" Binding="{Binding Nem, Mode=OneWay}" Width="70" />
                        <DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor, Mode=OneWay}" Width="80" />
                        <DataGridCheckBoxColumn Header="OR" Binding="{Binding OR, Mode=OneWay}" Width="80" />
                        <DataGridCheckBoxColumn Header="VR" Binding="{Binding VR, Mode=OneWay}" Width="80" />
                        <DataGridCheckBoxColumn Header="ER" Binding="{Binding ER, Mode=OneWay}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" FontSize="11" Foreground="Gray" Text="OR = olimpiai csúcs, VR = világcsúcs, ER = Európa-csúcs" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" Background="White" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtLetszam" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button x:Name="btnMentes" Grid.Column="1" Content="FÁJLBA MENTÉS" Margin="0,0,16,0" Width="210" Height="32" Click="Mentes_Click" VerticalAlignment="Center" />
                <Button x:Name="btnBetoltes" Grid.Column="2" Content="FÁJLBÓL BETÖLTÉS" Width="210" Height="32" Click="Betoltes_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>